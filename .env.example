# lotus-voice environment configuration

# Server
FLASK_PORT=5031
FLASK_DEBUG=true

# ElevenLabs (optional - commercial TTS)
# ELEVEN_LABS_API_KEY=your_key_here

# Bark settings
# BARK_MODELS_DIR=~/.bark_models
# SUNO_USE_SMALL_MODELS=true  # Use smaller models for faster generation

# eSpeak-NG path (usually auto-detected)
# ESPEAK_NG_PATH=/opt/homebrew/bin/espeak-ng

# Output directories
AUDIOBOOK_OUTPUT_DIR=data/audiobooks
VOICE_LIBRARY_PATH=data/voices/library.json
