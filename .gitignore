# =============================================================================
# Lotus-Eater 2.0 - Master .gitignore Template
# =============================================================================
# Apply to all repos with: lotus-git.py sync-gitignore
# Last updated: 2026-02-04
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Node.js / JavaScript / TypeScript
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.output/

# Testing
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Expo / React Native
.expo/
*.jks
*.p8
*.p12
*.mobileprovision

# Metro bundler
.metro-health-check*

# -----------------------------------------------------------------------------
# Databases
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal

# Redis
dump.rdb

# -----------------------------------------------------------------------------
# Secrets & Environment
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
*.pem
*.key
*.crt
*.p12
secrets.json
credentials.json
service-account*.json

# Keep example files
!.env.example
!.env.template

# -----------------------------------------------------------------------------
# IDE & Editors
# -----------------------------------------------------------------------------
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.#*

# -----------------------------------------------------------------------------
# Operating System
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# -----------------------------------------------------------------------------
# Logs & Temporary Files
# -----------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.backup
firebase-debug.log
npm-debug.log
yarn-debug.log
lerna-debug.log

# -----------------------------------------------------------------------------
# Build & Package Artifacts
# -----------------------------------------------------------------------------
*.tar.gz
*.zip
*.rar
*.7z

# Python wheels
*.whl

# Compiled binaries
*.exe
*.dll
*.dylib

# -----------------------------------------------------------------------------
# Framework-Specific
# -----------------------------------------------------------------------------
# Flask
instance/
.webassets-cache

# Django
*.pot
local_settings.py
staticfiles/
mediafiles/

# FastAPI / Starlette
.pytest_cache/

# Firebase
.firebase/
firebase-debug.log

# Render
.render/

# Vercel
.vercel/

# Netlify
.netlify/

# -----------------------------------------------------------------------------
# Documentation
# -----------------------------------------------------------------------------
# Sphinx
docs/_build/
site/

# MkDocs
site/

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
# Thumbnails
*.thumb
*.thumbnail

# Backup files
*.orig

# Lock files (keep in version control, but listing here for reference)
# !package-lock.json
# !yarn.lock
# !poetry.lock
# !Pipfile.lock

# Generated files that shouldn't be tracked
*.generated.*
*.min.js
*.min.css

# =============================================================================
# Project-Specific Patterns (preserved from original)
# =============================================================================

# Generated audio files
data/audiobooks/*.wav
data/audiobooks/*.mp3
data/audiobooks/*.m3u

# Full audiobooks data directory (large media files)
data/audiobooks/

# Bark models cache
.bark_models/

# Generated WAV test files
test_output/

# Windows shell artifacts (> /dev/null creates literal files)
nul
NUL

# UE5 / Unreal Engine
Intermediate/
Saved/
DerivedDataCache/

# Large binary exports (keep locally, don't push)
*.obj
*.bgeo
*.bgeo.sc

# Cached ML data
**/face_cache/
