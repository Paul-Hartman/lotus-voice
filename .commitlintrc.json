{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert"
      ]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "api",
        "ui",
        "db",
        "mobile",
        "tools",
        "decks",
        "skills",
        "cards",
        "auth",
        "tests",
        "docs",
        "deps",
        "ci",
        "config",
        "deploy"
      ]
    ],
    "subject-case": [0],
    "subject-max-length": [2, "always", 72],
    "header-max-length": [2, "always", 72],
    "body-max-line-length": [0],
    "body-min-length": [1, "always", 10]
  }
}
